{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "vuetify-mcp": {
      "type": "remote",
      "url": "https://mcp.vuetifyjs.com/mcp",
      "enabled": false,
      "oauth": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": false,
      "timeout": 30000
    }
  }
}
